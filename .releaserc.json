{
  "branches": ["main", { "name": "beta", "prerelease": true }],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Nouveautés" },
            { "type": "fix", "section": "Corrections" },
            { "type": "perf", "section": "Performances" },
            { "type": "revert", "section": "Retours en arrière" },
            { "type": "docs", "hidden": true },
            { "type": "style", "hidden": true },
            { "type": "chore", "hidden": true },
            { "type": "refactor", "hidden": true },
            { "type": "test", "hidden": true },
            { "type": "build", "hidden": true },
            { "type": "ci", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/exec",
      { "prepareCmd": "bash scripts/release/build-android.sh ${nextRelease.version}" }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "release/voidpulse-v*.apk", "label": "Android APK (mises à jour intégrées)" },
          { "path": "release/voidpulse-v*.apk.sha256", "label": "SHA-256 de l'APK" },
          { "path": "release/voidpulse-v*.aab", "label": "Android App Bundle (Google Play)" }
        ],
        "successComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
